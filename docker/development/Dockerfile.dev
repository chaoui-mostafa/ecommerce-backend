FROM node:18-alpine

# Install build dependencies and debugging tools
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    curl \
    vim \
    bash \
    mongodb-tools \
    redis-tools

# Install global tools
RUN npm install -g \
    nodemon \
    pm2 \
    eslint \
    prettier \
    mongodb-memory-server

# Create app directory
WORKDIR /usr/src/app

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm install

# Copy source code
COPY . .

# Create uploads and logs directories
RUN mkdir -p uploads logs

# Expose ports
EXPOSE 5000 9229

# Start in development mode
CMD ["npm", "run", "dev"]